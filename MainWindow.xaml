<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions>
    <RowDefinition Height="45" />
    <RowDefinition Height="*" />
    <RowDefinition Height="45" />
  </Grid.RowDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}">
    <DockPanel LastChildFill="True" Margin="10,0">
      <Button x:Name="BackButton" Content="Назад" DockPanel.Dock="Left" ToolTip="Вернуться к списку или странице входа" />
      <Button x:Name="LogoutButton" Content="Выйти из аккаунта" DockPanel.Dock="Right" ToolTip="Завершить сеанс" />
      <Button x:Name="ThemeButton" Content="Сменить тему" DockPanel.Dock="Right" ToolTip="Светлая или тёмная тема сохраняется после выхода" />
      <TextBlock x:Name="PageTitle" Text="CyberClub • Авторизация" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" Margin="15,0" />
    </DockPanel>
  </Border>
  <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" />
  <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}">
    <DockPanel Margin="20,0">
      <TextBlock x:Name="Clock" DockPanel.Dock="Right" VerticalAlignment="Center" />
      <TextBlock x:Name="AccountLabel" Text="Сеть киберспортивных клубов" VerticalAlignment="Center" />
    </DockPanel>
  </Border>
</Grid>